# AQUENZA Production & Staging Environment Variable Configuration
# Never commit actual secret passwords or production credentials to public GitHub repositories.
# Configure these securely in your Render Web Service -> Environment tab.

# Server Runtime
PORT=3000
NODE_ENV=production

# Public Domain / Base URL for Dynamic Scannable QR Codes
PUBLIC_SITE_URL=https://aquenza.onrender.com

# Administrator Security Credentials
ADMIN_EMAIL=admin@aquenza.in
ADMIN_INITIAL_PASSWORD=Aquenza@2026!Admin
SESSION_SECRET=create_a_random_32_character_string_for_cookie_signing

# Gmail SMTP Business Enquiry Integration
# Official Business Email: aquenza.service@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=aquenza.service@gmail.com
SMTP_APP_PASSWORD=your_16_character_gmail_app_password
EMAIL_FROM=AQUENZA Website <aquenza.service@gmail.com>
EMAIL_TO=aquenza.service@gmail.com

# Database Connection (Optional Free-tier Managed PostgreSQL: Neon / Supabase)
# Leave blank to use the built-in local persistent JSON relational store (data/aquenza_store.json)
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Business Contact Numbers (Publicly Displayed)
PHONE_PRIMARY=8630071125
PHONE_SECONDARY=8755306639
